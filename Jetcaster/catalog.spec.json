{
  "$schema": "https://raw.githubusercontent.com/yschimke/compose-ai-tools/main/scripts/design-artifacts/catalog.spec.schema.json",
  "$comment": "Jetcaster (mobile) sticker sheet. Jetcaster is the multi-form-factor sample — phone, Wear, TV and a Glance widget share one core. This catalog covers the phone tier; the Wear tier has its own sheet in catalog.wear.spec.json so the two can be compared side by side.",
  "system": "jetcaster",
  "title": "Jetcaster",
  "library": [
    "androidx.compose.material3:material3",
    "androidx.compose.material3.adaptive:adaptive"
  ],
  "module": ":mobile",
  "modes": ["light", "dark"],
  "breakpoints": [
    { "size": "compact", "widthDp": 412 },
    { "size": "medium", "widthDp": 700 },
    { "size": "expanded", "widthDp": 960 }
  ],
  "compareWith": "jetcaster-wear",
  "display": {
    "surface": "dark",
    "hero": "Podcast/Card"
  },
  "groupOrder": ["Discover", "Player", "Chrome"],
  "groups": [
    {
      "name": "Discover",
      "section": "Components",
      "components": [
        {
          "componentId": "Podcast/Card",
          "preview": "PreviewPodcastCard",
          "caption": "Podcast card as it appears in the discover carousel — artwork drives the surrounding dynamic colour.",
          "parallel": "Podcast/Row"
        },
        {
          "componentId": "Podcast/Details header",
          "preview": "PodcastDetailsHeaderItemPreview",
          "caption": "Podcast details header: artwork, title, and the follow affordance."
        },
        {
          "componentId": "Episode/List item",
          "preview": "EpisodeListItemPreview",
          "caption": "Episode row with duration and download state.",
          "parallel": "Episode/Screen",
          "variants": [
            {
              "preview": "PreviewEpisodeListItem",
              "caption": "Episode row in its alternate content configuration."
            }
          ]
        }
      ]
    },
    {
      "name": "Player",
      "section": "Components",
      "components": [
        {
          "componentId": "Player/Transport",
          "preview": "PlayerButtonsPreview",
          "caption": "Playback transport controls — the touch-target sizes here are what the a11y greenlines check.",
          "parallel": "Player/Controls"
        }
      ]
    },
    {
      "name": "Chrome",
      "section": "Screens",
      "components": [
        {
          "componentId": "Chrome/Home app bar",
          "preview": "HomeAppBarPreview",
          "caption": "Home app bar with search and profile affordances."
        },
        {
          "componentId": "Chrome/Top app bar",
          "preview": "TopAppBarPreview",
          "caption": "Standard top app bar."
        },
        {
          "componentId": "Chrome/Home error",
          "preview": "HomeScreenErrorPreview",
          "caption": "Home in its error state — the failure path, rendered rather than described."
        }
      ]
    }
  ]
}
