{
  "$schema": "https://raw.githubusercontent.com/yschimke/compose-ai-tools/main/scripts/design-artifacts/catalog.spec.schema.json",
  "$comment": "Jetcaster's Wear OS tier as its own sticker sheet. Wear is a separate design system — androidx.wear.compose.material3, round device frames, and its own layout idioms — so it gets a separate catalog rather than being folded into the phone sheet. compareWith pairs it against the phone catalog so the same feature can be read across form factors. Primary functions use the local single-device @JetcasterWearLargeRoundPreview; small-round and largest-font captures are explicit catalog variants.",
  "system": "jetcaster-wear",
  "title": "Jetcaster for Wear OS",
  "library": [
    "androidx.wear.compose:compose-material3",
    "androidx.wear.compose:compose-foundation"
  ],
  "module": ":wear",
  "modes": ["dark"],
  "breakpoints": [
    { "size": "smallRound", "widthDp": 192 },
    { "size": "largeRound", "widthDp": 227 }
  ],
  "compareWith": "jetcaster",
  "display": {
    "surface": "dark",
    "hero": "Podcast/Screen"
  },
  "groupOrder": ["Browse", "Playback", "Components", "States"],
  "groups": [
    {
      "name": "Browse",
      "section": "Screens",
      "components": [
        {
          "componentId": "Podcast/Screen",
          "preview": "PodcastScreenLoadedPreview",
          "caption": "Podcast browse list on a round face — the Wear counterpart of the phone's discover carousel.",
          "parallel": "Podcast/Card",
          "variants": [
            {
              "preview": "PodcastScreenSmallCatalogPreview",
              "caption": "Podcast browse list on a small round display.",
              "props": {
                "device": "smallRound"
              }
            },
            {
              "preview": "PodcastScreenLargestFontCatalogPreview",
              "caption": "Podcast browse list at Wear's largest 1.24× font scale.",
              "props": {
                "device": "smallRound",
                "fontScale": 1.24
              }
            }
          ]
        },
        {
          "componentId": "Podcast/Details",
          "preview": "PodcastDetailsScreenLoadedPreview",
          "caption": "Podcast details on Wear.",
          "variants": [
            {
              "preview": "PodcastDetailsSmallCatalogPreview",
              "caption": "Podcast details on a small round display.",
              "props": {
                "device": "smallRound"
              }
            },
            {
              "preview": "PodcastDetailsLargestFontCatalogPreview",
              "caption": "Podcast details at Wear's largest 1.24× font scale.",
              "props": {
                "device": "smallRound",
                "fontScale": 1.24
              }
            }
          ]
        },
        {
          "componentId": "Library/Screen",
          "preview": "LibraryScreenPreview",
          "caption": "The user's library entry point.",
          "variants": [
            {
              "preview": "LibraryScreenSmallCatalogPreview",
              "caption": "Library entry point on a small round display.",
              "props": {
                "device": "smallRound"
              }
            }
          ]
        },
        {
          "componentId": "Episode/Latest",
          "preview": "LatestEpisodeScreenLoadedPreview",
          "caption": "Latest-episode screen — the primary Wear launch surface.",
          "variants": [
            {
              "preview": "LatestEpisodeSmallCatalogPreview",
              "caption": "Latest-episode screen on a small round display.",
              "props": {
                "device": "smallRound"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Playback",
      "section": "Screens",
      "components": [
        {
          "componentId": "Episode/Screen",
          "preview": "EpisodeScreenLoadedPreview",
          "caption": "Episode detail with playback controls, loaded.",
          "parallel": "Episode/List item",
          "variants": [
            {
              "preview": "EpisodeScreenSmallCatalogPreview",
              "caption": "Episode detail on a small round display.",
              "props": {
                "device": "smallRound"
              }
            },
            {
              "preview": "EpisodeScreenLargestFontCatalogPreview",
              "caption": "Episode detail at Wear's largest 1.24× font scale.",
              "props": {
                "device": "smallRound",
                "fontScale": 1.24
              }
            }
          ]
        },
        {
          "componentId": "Queue/Screen",
          "preview": "QueueScreenLoadedPreview",
          "caption": "Playback queue, populated.",
          "variants": [
            {
              "preview": "QueueScreenSmallCatalogPreview",
              "caption": "Playback queue on a small round display.",
              "props": {
                "device": "smallRound"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Components",
      "section": "Components",
      "components": [
        {
          "componentId": "Podcast/Content",
          "preview": "PodcastContentPreview",
          "caption": "Podcast content block as laid out for a round display.",
          "variants": [
            {
              "preview": "PodcastContentSmallCatalogPreview",
              "caption": "Podcast content block on a small round display.",
              "props": {
                "device": "smallRound"
              }
            }
          ]
        },
        {
          "componentId": "Player/Controls",
          "preview": "MediaContentPreview",
          "caption": "Media content and transport on a round face — where Wear's touch-target minimums bite hardest.",
          "parallel": "Player/Transport",
          "variants": [
            {
              "preview": "PlayerControlsSmallCatalogPreview",
              "caption": "Media content and transport on a small round display.",
              "props": {
                "device": "smallRound"
              }
            },
            {
              "preview": "PlayerControlsLargestFontCatalogPreview",
              "caption": "Media content and transport at Wear's largest 1.24× font scale.",
              "props": {
                "device": "smallRound",
                "fontScale": 1.24
              }
            }
          ]
        }
      ]
    },
    {
      "name": "States",
      "section": "Screens",
      "components": [
        {
          "componentId": "Episode/Loading",
          "preview": "EpisodeScreenLoadingPreview",
          "caption": "Episode screen while loading.",
          "variants": [
            {
              "preview": "EpisodeLoadingSmallCatalogPreview",
              "caption": "Episode loading state on a small round display.",
              "props": {
                "device": "smallRound"
              }
            }
          ]
        }
      ]
    }
  ]
}
