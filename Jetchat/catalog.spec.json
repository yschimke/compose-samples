{
  "$schema": "https://raw.githubusercontent.com/yschimke/compose-ai-tools/main/scripts/design-artifacts/catalog.spec.schema.json",
  "$comment": "Jetchat sticker sheet. Jetchat's distinguishing feature is that almost every surface has a dark counterpart authored as a separate @Preview function — so the catalog uses `theme` variants to fold each light/dark pair onto one swap card instead of listing them twice. The chat-specific state ladders (own vs other author, first/last in an author group, sticker attachment, formatted @mention / `code` / link spans) come from the debug-only previews in JetchatComponentPreviews.kt. NOTE: MessageItemPreview/WidgetPreview are Glance app-widget composables, not Compose UI — the renderer times out after 180s waiting for them and reports them as missing renders. They need the Glance render path, so they are out of this sheet.",
  "system": "jetchat",
  "title": "Jetchat",
  "library": [
    "androidx.compose.material3:material3"
  ],
  "module": ":app",
  "modes": [
    "light",
    "dark"
  ],
  "breakpoints": [
    {
      "size": "compact",
      "widthDp": 412
    },
    {
      "size": "medium",
      "widthDp": 700
    }
  ],
  "display": {
    "surface": "light",
    "hero": "Conversation/Screen"
  },
  "groupOrder": [
    "Conversation",
    "Conversation components",
    "Messages",
    "Composer",
    "Profile",
    "Profile components",
    "Chrome"
  ],
  "groups": [
    {
      "name": "Conversation",
      "section": "Screens",
      "components": [
        {
          "componentId": "Conversation/Screen",
          "preview": "JetchatConversationContentLightPreview",
          "caption": "Conversation screen — message list, input bar and app bar together.",
          "variants": [
            {
              "preview": "JetchatConversationContentMediumPreview",
              "caption": "Conversation screen at the 700dp medium breakpoint.",
              "props": {
                "breakpoint": "medium"
              }
            },
            {
              "preview": "JetchatConversationContentEmptyPreview",
              "caption": "Channel with no messages yet; composer and channel chrome remain available.",
              "state": "empty"
            }
          ]
        }
      ]
    },
    {
      "name": "Conversation components",
      "section": "Components",
      "components": [
        {
          "componentId": "Conversation/Day header",
          "preview": "DayHeaderPrev",
          "caption": "Date separator between message groups."
        },
        {
          "componentId": "Conversation/Jump to bottom",
          "preview": "JetchatJumpToBottomLightPreview",
          "caption": "Jump-to-bottom affordance that appears when scrolled away from the latest message."
        }
      ]
    },
    {
      "name": "Messages",
      "section": "Components",
      "components": [
        {
          "componentId": "Messages/Row",
          "preview": "JetchatMessageOtherPreview",
          "caption": "A single message row from another author — avatar, name, timestamp and bubble.",
          "variants": [
            {
              "preview": "JetchatMessageMePreview",
              "caption": "Own message: primary-tinted bubble, right-aligned author line, no avatar.",
              "props": {
                "author": "me"
              }
            },
            {
              "preview": "JetchatMessageContinuationPreview",
              "caption": "Neither first nor last in the author's group — no avatar, no author/timestamp header.",
              "state": "continuation"
            },
            {
              "preview": "JetchatMessageGroupHeadPreview",
              "caption": "First visible row in an author group — avatar and author line are present, with compact spacing to the next bubble.",
              "state": "group-head"
            },
            {
              "preview": "JetchatMessageGroupTailPreview",
              "caption": "Last row in an author group — no repeated identity, with the larger inter-author gap below.",
              "state": "group-tail"
            },
            {
              "preview": "JetchatMessageWithImagePreview",
              "caption": "Message carrying the sticker attachment.",
              "props": {
                "content": "image"
              }
            },
            {
              "preview": "JetchatMessageLongTextPreview",
              "caption": "Long body with an emoji and an https link — the widest formatter coverage.",
              "props": {
                "content": "long text + link"
              }
            },
            {
              "preview": "JetchatMessageMeDarkPreview",
              "caption": "Own message, dark theme.",
              "theme": "dark",
              "props": {
                "author": "me"
              }
            }
          ]
        },
        {
          "componentId": "Messages/Author and text",
          "preview": "JetchatAuthorAndTextMessagePreview",
          "caption": "Author name + timestamp header above the bubble, shown on the group head.",
          "variants": [
            {
              "preview": "JetchatAuthorAndTextMessageContinuedPreview",
              "caption": "Continuation row — the header is suppressed.",
              "state": "continuation",
              "props": {
                "grouping": "continuation"
              }
            }
          ]
        },
        {
          "componentId": "Messages/Bubble",
          "preview": "JetchatChatItemBubbleOtherPreview",
          "caption": "Message bubble as drawn for another author.",
          "variants": [
            {
              "preview": "JetchatChatItemBubbleMePreview",
              "caption": "Own bubble — primary container colour.",
              "props": {
                "author": "me"
              }
            },
            {
              "preview": "JetchatChatItemBubbleWithImagePreview",
              "caption": "Bubble with the sticker image attached below the text.",
              "props": {
                "content": "image"
              }
            }
          ]
        },
        {
          "componentId": "Messages/Clickable text",
          "preview": "JetchatClickableMessagePreview",
          "caption": "Formatted message body — @mention and inline `code` spans.",
          "variants": [
            {
              "preview": "JetchatClickableMessagePrimaryPreview",
              "caption": "Own-message styling with an https link.",
              "props": {
                "author": "me"
              }
            }
          ]
        },
        {
          "componentId": "Messages/List",
          "preview": "JetchatMessagesPreview",
          "caption": "The full message list with author grouping and day headers."
        }
      ]
    },
    {
      "name": "Composer",
      "section": "Components",
      "components": [
        {
          "componentId": "Conversation/Input",
          "preview": "UserInputPreview",
          "caption": "Message composer with its emoji/attachment selectors."
        },
        {
          "componentId": "Composer/Emoji selector",
          "preview": "JetchatEmojiSelectorPreview",
          "caption": "Expanded emoji selector panel with its Emojis/Stickers tabs.",
          "variants": [
            {
              "preview": "JetchatEmojiTablePreview",
              "caption": "The emoji grid on its own.",
              "props": {
                "part": "table only"
              }
            }
          ]
        },
        {
          "componentId": "Composer/Selector tab",
          "preview": "JetchatExtendedSelectorInnerButtonSelectedPreview",
          "caption": "Selector tab in its selected state.",
          "variants": [
            {
              "preview": "JetchatExtendedSelectorInnerButtonUnselectedPreview",
              "caption": "Selector tab, unselected.",
              "state": "unselected"
            }
          ]
        },
        {
          "componentId": "Composer/Not available",
          "preview": "JetchatFunctionalityNotAvailablePanelPreview",
          "caption": "Placeholder panel shown for the unimplemented composer selectors.",
          "variants": [
            {
              "preview": "JetchatFunctionalityNotAvailablePopupPreview",
              "caption": "The same message as a dismissable alert instead of an inline panel.",
              "props": {
                "presentation": "popup"
              }
            }
          ]
        },
        {
          "componentId": "Composer/Record button",
          "preview": "JetchatRecordButtonIdlePreview",
          "caption": "Voice-record button at rest.",
          "variants": [
            {
              "preview": "JetchatRecordButtonRecordingPreview",
              "caption": "Recording — the button is scaled up and tinted.",
              "state": "recording"
            }
          ]
        }
      ]
    },
    {
      "name": "Profile",
      "section": "Screens",
      "components": [
        {
          "componentId": "Profile/Screen",
          "preview": "ProfilePreview340",
          "caption": "Own profile at 340dp — the narrowest supported width.",
          "variants": [
            {
              "preview": "ProfilePreview340MeDark",
              "caption": "340dp, dark theme.",
              "theme": "dark"
            },
            {
              "preview": "ProfilePreview480Me",
              "caption": "Own profile at 480dp.",
              "props": {
                "widthDp": 480
              }
            },
            {
              "preview": "ProfilePreview480MeDark",
              "caption": "480dp own profile, dark theme.",
              "theme": "dark",
              "props": {
                "widthDp": 480
              }
            },
            {
              "preview": "ProfilePreview480Other",
              "caption": "480dp, another user's profile.",
              "props": {
                "widthDp": 480,
                "subject": "other"
              }
            },
            {
              "preview": "ProfilePreview480OtherDark",
              "caption": "480dp other user, dark theme.",
              "theme": "dark",
              "props": {
                "widthDp": 480,
                "subject": "other"
              }
            },
            {
              "preview": "JetchatProfileScreenMediumPreview",
              "caption": "Own profile at the 700dp medium breakpoint.",
              "props": {
                "widthDp": 700
              }
            },
            {
              "preview": "JetchatProfileScreenMediumDarkPreview",
              "caption": "700dp, another user, dark theme.",
              "theme": "dark",
              "props": {
                "widthDp": 700,
                "subject": "other"
              }
            },
            {
              "preview": "ConvPreviewPortraitMeDefault",
              "caption": "Own profile in a short 360 × 480dp portrait window.",
              "props": {
                "widthDp": 360,
                "heightDp": 480
              }
            },
            {
              "preview": "ConvPreviewLandscapeMeDefault",
              "caption": "Own profile in a 640 × 360dp landscape window.",
              "props": {
                "widthDp": 640,
                "heightDp": 360,
                "orientation": "landscape"
              }
            },
            {
              "preview": "ConvPreviewPortraitOtherDefault",
              "caption": "Another user's profile in a short portrait window.",
              "props": {
                "widthDp": 360,
                "heightDp": 480,
                "subject": "other"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Profile components",
      "section": "Components",
      "components": [
        {
          "componentId": "Profile/FAB",
          "preview": "ProfileFabPreview",
          "caption": "Profile action button.",
          "variants": [
            {
              "preview": "JetchatProfileFabMeExtendedPreview",
              "caption": "Own profile — the extended \"Edit Profile\" FAB.",
              "props": {
                "subject": "me"
              }
            },
            {
              "preview": "JetchatProfileFabMeCollapsedPreview",
              "caption": "Own profile, collapsed to the icon after scrolling.",
              "state": "collapsed",
              "props": {
                "subject": "me"
              }
            },
            {
              "preview": "JetchatProfileFabOtherCollapsedPreview",
              "caption": "Another user's profile, collapsed.",
              "state": "collapsed",
              "props": {
                "subject": "other"
              }
            }
          ]
        },
        {
          "componentId": "Profile/Animating FAB content",
          "preview": "JetchatAnimatingFabContentExtendedPreview",
          "caption": "The icon+label layout that animates between the FAB's two sizes.",
          "variants": [
            {
              "preview": "JetchatAnimatingFabContentCollapsedPreview",
              "caption": "Collapsed — the label is clipped away, leaving the icon.",
              "state": "collapsed"
            }
          ]
        },
        {
          "componentId": "Profile/Property",
          "preview": "JetchatProfilePropertyPreview",
          "caption": "Label/value pair used for every field on the profile screen.",
          "variants": [
            {
              "preview": "JetchatProfilePropertyLinkPreview",
              "caption": "Link styling for the Twitter handle.",
              "props": {
                "content": "link"
              }
            },
            {
              "preview": "JetchatProfilePropertyAwayPreview",
              "caption": "Another user's away status and timezone.",
              "props": {
                "subject": "other"
              }
            }
          ]
        },
        {
          "componentId": "Profile/Error",
          "preview": "JetchatProfileErrorPreview",
          "caption": "Shown when the requested profile can't be resolved."
        }
      ]
    },
    {
      "name": "Chrome",
      "section": "Components",
      "components": [
        {
          "componentId": "Chrome/App bar",
          "preview": "JetchatAppBarPreview",
          "caption": "Jetchat app bar."
        },
        {
          "componentId": "Chrome/Drawer",
          "preview": "DrawerPreview",
          "caption": "Navigation drawer listing channels and direct messages.",
          "variants": [
            {
              "preview": "JetchatDrawerContentChatSelectedPreview",
              "caption": "Selection moved to the second chat row.",
              "state": "chat selected"
            },
            {
              "preview": "JetchatDrawerContentProfileSelectedPreview",
              "caption": "A profile is the current destination, so no chat row is highlighted.",
              "state": "profile selected"
            },
            {
              "preview": "JetchatDrawerContentProfileSelectedDarkPreview",
              "caption": "Profile selected, dark theme.",
              "theme": "dark",
              "state": "profile selected"
            }
          ]
        },
        {
          "componentId": "Chrome/Drawer shell",
          "preview": "JetchatDrawerOpenPreview",
          "caption": "The modal drawer open over the conversation, scrim included.",
          "variants": [
            {
              "preview": "JetchatDrawerClosedPreview",
              "caption": "Drawer closed — the underlying conversation is interactive again.",
              "state": "closed"
            }
          ]
        },
        {
          "componentId": "Chrome/Channel bar",
          "preview": "ChannelBarPrev",
          "caption": "Channel name bar.",
          "variants": [
            {
              "preview": "JetchatChannelNameBarLongNamePreview",
              "caption": "A channel name long enough to test truncation.",
              "props": {
                "content": "long name"
              }
            }
          ]
        },
        {
          "componentId": "Chrome/Icon",
          "preview": "JetchatIconPreview",
          "caption": "The Jetchat mark used in the app bar and drawer header."
        },
        {
          "componentId": "Chrome/Divider",
          "preview": "JetchatDividerItemPreview",
          "caption": "Section divider used between drawer groups."
        }
      ]
    }
  ]
}
